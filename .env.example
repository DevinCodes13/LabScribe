# Copy this file to .env and fill in your values.
# The real .env is gitignored and must NEVER be committed.
# In normal use you don't edit this by hand — the Settings screen writes it for you.

# VirtualBox shared folder the lab VMs write transcripts/screenshots/notes into
LABSCRIBE_SHARED_FOLDER=C:\LabCapture

# Local clone of the GitHub repo LabScribe documents into
LABSCRIBE_REPO_PATH=C:\Path\To\your-lab-repo

# Lab subnet for nmap discovery (isolated lab network only)
LABSCRIBE_LAB_SUBNET=10.10.10.0/24

# Anthropic API key — used only for doc synthesis, never logged, never committed
ANTHROPIC_API_KEY=
